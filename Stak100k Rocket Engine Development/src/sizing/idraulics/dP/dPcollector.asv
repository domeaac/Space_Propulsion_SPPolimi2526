function dP=dPcollector(N,mdot,d1,d2,rho,Lequivalent)

% Lequivalent [m] circumference of the initial part of the cooling jacket
% N must be even

vInlet = (4 * mdot) / (rho * pi * d1^2);
vChannels = (4 * mdot) / (rho * pi * d2^2);
mdotChannels=mdot/N;
mdotBranch=mdot/2; % mass rate passing through each circular half of the collector
lsection=Lequivalent/N;

% modelled as a ring-collector that distributes the fluid coming from a
% lareger pipe into N smaller chennales. 
% Assumptions:
% -constant mass rate in each channels
% -curvature effects trascured as it is assumed that the relative curvature
% -is large enough so the Dean numer (De) is small
% - turbolent effects caused by the rejoining of the 2 flows not considered
% - the pressure losses happend only in the fluid that are being
% diverted/collected in the channels

% The pressure losses considered are:
% -the friction losses from the main pipe walls
% -the bend losses for entering the in small channels
% - the loss as the fluid split as it enters the collector

%-----------------------------losses in main pipe---------------------%

q=zeros(N/2,1); % vector containing teh remaining flow rate before the i-th channel
velMain=zeros(N/2,1); % vector containing the flow velocity in each section before the i-th channel
Re=zeros(N/2,1); % vector cpontaining the reynold of every section 
f=zeros(N/2,1); %..... Darcy coeff
dPSection=0;

q(1)=mdotBranch;
velMain(1)= (4 * mdotBranch) / (rho * pi * d1^2);
Re(1) = reynolds(rho,mu,v(1),lsection);

for i=1:N/2
    
    q(i+1)=q(i)-mdotChannels;
    velMain(i+1) = (4 * q(i+1)) / (rho * pi * di^2);
    Re(i)=reynolds(rho,mu,v(i),lsection);
    f(i) = DarcyStraightTubes(Re(i)); 

    dPSection=dPSection+0.5*rho*v(i)^2*f(i)*lsection/d1;

end


%-------------------------losses of inlet of each channel-----------------%

% formula from page 254 of handbook, assumed welded tees
% "mean velocity in the common channel" approximated as velocity of the
% section before the channel
dPChannels=0;

for i=1:N/2

    K(i)=1+0.3*(vChannels/v(i))^2;
    dPChannels=dPChannels+0.5*rho*v(i)^2;

end

%---------------------losses of first T divider---------------------------%

K(i)=1+0.3*(vChannels/v(i))^2;

end